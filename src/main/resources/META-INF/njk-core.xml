<!--
  Everything the plugin does. Loaded only where XML/HTML support is available: the full IDE, or the backend
  in remote development. The JetBrains Client frontend has no XML support and doesn't need any of this.
-->
<idea-plugin>
    <depends optional="true" config-file="njk-javascript.xml">JavaScript</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Nunjucks" implementationClass="dev.njk.NjkFileType" fieldName="INSTANCE"
                  language="Nunjucks" extensions="njk;nunjucks"/>
        <lang.parserDefinition language="Nunjucks" implementationClass="dev.njk.parser.NjkParserDefinition"/>
        <lang.fileViewProviderFactory language="Nunjucks" implementationClass="dev.njk.template.NjkFileViewProviderFactory"/>

        <lang.syntaxHighlighterFactory language="Nunjucks" implementationClass="dev.njk.highlight.NjkSyntaxHighlighterFactory"/>
        <editorHighlighterProvider filetype="Nunjucks" implementationClass="dev.njk.highlight.NjkEditorHighlighterProvider"/>
        <colorSettingsPage implementation="dev.njk.highlight.NjkColorSettingsPage"/>
        <annotator language="Nunjucks" implementationClass="dev.njk.highlight.NjkAnnotator"/>

        <lang.braceMatcher language="Nunjucks" implementationClass="dev.njk.editor.NjkBraceMatcher"/>
        <lang.commenter language="Nunjucks" implementationClass="dev.njk.editor.NjkCommenter"/>
        <multiLangCommenter implementation="dev.njk.editor.NjkCommentProvider"/>
        <lang.foldingBuilder language="Nunjucks" implementationClass="dev.njk.editor.NjkFoldingBuilder"/>
        <typedHandler implementation="dev.njk.editor.NjkTypedHandler"/>
        <lang.findUsagesProvider language="Nunjucks" implementationClass="dev.njk.editor.NjkFindUsagesProvider"/>
        <lang.refactoringSupport language="Nunjucks" implementationClass="dev.njk.editor.NjkRefactoringSupportProvider"/>
        <lang.documentationProvider language="Nunjucks" implementationClass="dev.njk.docs.NjkDocumentationProvider"/>
        <codeInsight.lineMarkerProvider language="Nunjucks" implementationClass="dev.njk.editor.NjkBlockLineMarkerProvider"/>

        <completion.contributor language="Nunjucks" implementationClass="dev.njk.completion.NjkCompletionContributor"/>
        <fileBasedIndex implementation="dev.njk.index.NjkIndex"/>

        <liveTemplateContext contextId="NUNJUCKS" implementation="dev.njk.editor.NjkTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/Nunjucks.xml"/>
    </extensions>
</idea-plugin>
